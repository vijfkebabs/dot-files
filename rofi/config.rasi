configuration {
    modi: "drun,run,filebrowser,window";
    case-sensitive: false;
    cycle: true;
    normalize-match: true;
    show-icons: true;
    matching: "normal";
    tokenize: true;

    kb-cancel: "Escape,MousePrimary";
    kb-page-prev: "ScrollUp";
    kb-page-next: "ScrollDown";
    ml-row-down: "";
    ml-row-up: "";

    /*---------- Drun settings ----------*/
    drun-match-fields: "name,exec,generic,comment";
    drun-display-format: "{name} <span size='small'><i>({comment})</i></span>";
    drun-url-launcher: "xdg-open";
    drun-show-actions: false;
    drun-use-desktop-cache: false;
    drun-reload-desktop-cache: false;
    drun {
        parse-user:   true;
        parse-system: true;
    }

    /*---------- Run settings ----------*/
    run-command: "{cmd}";
    run-shell-command: "{terminal} -e {cmd}";

    /*---------- Fallback Icons ----------*/
    run, drun {
        fallback-icon: "application-default-icon";
    }

    filebrowser {
        fallback-icon: "application-x-zerosize";
    }

    /*---------- Wayland Window Switcher settings ----------*/
    window-match-fields: "title,class";
    window-command: "wmctrl -i -R {window}";
    window-format: "{w} - {c} - {t:0}";
    window-thumbnail: true;

    disable-history: false;
    sorting-method: "normal";

    /*---------- Misc setting ----------*/
    terminal: "kitty";
    sort: false;
    threads: 0;

    /*---------- File browser settings ----------*/
    filebrowser {
      show-hidden: true;
      directories-first: true;
      sorting-method:    "mtime";
    }

    /*---------- Other settings ----------*/
    timeout {
      action: "kb-cancel";
      delay:  0;
    }

    hover-select: true;
    me-select-entry: "";
    me-accept-entry: [ MousePrimary ];
}

/* -------------------------------------------------------------------------
 * IMPORTS & THEME SETUP
 * ------------------------------------------------------------------------- */
@import "colors.rasi"

* {
    font: "CaskaydiaCove Nerd Font, bold 12";
}

/* Main Rofi window */
window {
    transparency:      "real";
    background-color:  @base;
    border:             2px;
    border-color:       @selected;
    border-radius:      18px;
    width:              450px;
    padding:            18px;
}

mainbox {
    background-color:  transparent;
    spacing:           10px;
    children:          [ "inputbar", "listview" ];
}

/* Search bar */
inputbar {
    background-color:  @background-alt;
    text-color:        @text;
    border-radius:     14px;
    padding:           10px 15px;
    spacing:           10px;
    children:          [ "prompt", "entry" ];
}

prompt {
    background-color:  transparent;
    text-color:        @subtext;
}

entry {
    background-color:  transparent;
    text-color:        @text;
    placeholder-color: @overlay;
    placeholder:       "Search...";
    cursor:            text;
}

case-indicator,
num-filtered-rows,
num-rows {
    background-color:  transparent;
    text-color:        @subtext;
}

/* Result list */
listview {
    background-color:  transparent;
    border-radius:     16px;
    padding:           12px 0px 0px 0px;
    spacing:           8px;
    columns:           1;
    lines:             10;
    fixed-height:      true;
    scrollbar:         false;
}

/* Element rows */
element {
    background-color:  @background-alt;
    text-color:        @text;
    padding:           8px 12px;
    border-radius:     12px;
    spacing:           10px;
    cursor:            pointer;
}

element normal.normal,
element alternate.normal {
    background-color:  @background-alt;
    text-color:        @text;
}

element selected.normal,
element selected.active,
element selected.urgent,
element normal.active,
element normal.urgent,
element alternate.active,
element alternate.urgent {
    background-color:  @selected;
    text-color:        @base;
}

element-icon {
    background-color:  transparent;
    size:              32px;
}

element-text {
    background-color:  transparent;
    text-color:        inherit;
    vertical-align:    0.5;
}