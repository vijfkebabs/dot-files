{
  "layer": "top",
  "position": "top",
  "spacing": 2,
  "height": 28,
  "margin-top": 1,
  "margin-left": 2,
  "margin-right": 2,
  "reload_style_on_change": true,

  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["group/stats", "group/controls"],

  "group/stats": {
    "orientation": "horizontal",
    "modules": ["mpris", "wireplumber", "custom/cpu", "memory", "battery"]
  },

  "group/controls": {
    "orientation": "horizontal",
    "modules": ["custom/bluetooth", "custom/wifi", "custom/notification", "custom/lock"]
  },

  "custom/tab": {
    "format": "[Z]",
    "on-click": "rofi -show drun"
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5]
    },
    "format-icons": {
      "default": "○",
      "active": "●",
      "urgent": "●"
    }
  },

    "battery": {
    "interval": 30,
    "states": {
      "warning": 30,
      "critical": 10
    },
    "events": {
      "on-discharging-warning": "notify-send -u normal 'Low Battery'",
      "on-discharging-critical": "notify-send -u critical 'Very Low Battery'"
    },
    "format": "{icon} {capacity}%",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "max-length": 25
  },

  "mpris": {
    "format": " {title} - {artist} ",
    "format-paused": "󰐊 {title} - {artist} ",
    "max-length": 40,
    "tooltip": true,
    "player": "spotify"
  },

  "wireplumber": {
    "scroll-step": 2,
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "on-click": "pavucontrol",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"],
      "headphones": "󰋋",
      "headset": "󰋎"
    }
  },
  "clock": {
    "locale": "en_GB.UTF-8",
    "format": "{:%a %d %b %H:%M:%S}",
    "format-alt": "{:%d/%m/%Y %H:%M:%S}",
    "interval": 1
  },

  "custom/lock": {
    "format": "",
    "on-click": "~/.local/share/quickshell-lockscreen/lock.sh",
    "tooltip": true,
    "tooltip-format": "Lock Screen"
  },

  "custom/notification": {
    "format": "",
    "on-click": "swaync-client -t",
    "tooltip": true,
    "tooltip-format": "Notifications"
  },
    "custom/bluetooth": {
    "format": "󰂯",
    "tooltip": true,
    "tooltip-format": "Open Bluetooth settings",
    "on-click": "blueman-manager"
  },

  "custom/wifi": {
    "format": "󰖩",
    "tooltip": true,
    "tooltip-format": "Open Wi-Fi settings",
    "on-click": "nm-connection-editor"
  },
  "memory": {
    "format": "󰍛 {used:0.1f}G",
    "tooltip": true,
    "tooltip-format": "RAM: Used {used:0.01f}G / Total {total:0.01f}G",
    "interval": 4,
    "on-click":"kitty --class btop-float -e btop"
  },

  "custom/cpu": {
    "exec": "sh -c \"usage=\\$(top -bn1 | awk '/Cpu\\\\(s\\\\)/ {for (i = 1; i <= NF; i++) if (\\$i == \\\"id,\\\") {printf \\\"%d\\\", 100 - \\$(i - 1); exit}}'); temp=\\$(sensors | awk '/Package id 0:/ {sub(/^[+]/, \\\"\\\", \\$4); print \\$4; exit}'); printf '󰻠 %s%% %s' \\\"\\$usage\\\" \\\"\\$temp\\\"\"",
    "interval": 4,
    "format": "{}",
    "tooltip": true,
    "tooltip-format": "CPU usage and temperature: {}",
    "on-click": "kitty --class btop-float -e btop"
  }

}
