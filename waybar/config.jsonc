{
  "layer": "top",
  "position": "top",
  "spacing": 2,
  "height": 28,
  "margin-top": 3,
  "margin-left": 4,
  "margin-right": 4,
  "reload_style_on_change": true,

  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],

  "modules-right": [
    "mpris",
    "wireplumber",
    "custom/cpu",
    "memory",
    "battery",
    "custom/bluetooth",
    "custom/wifi",
    "custom/notification",
    "custom/lock"
  ],

  "custom/tab": {
    "format": "[Z]",
    "on-click": "rofi -show drun"
  },

  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5]
    },
    "format-icons": {
      "default": "○",
      "active": "●",
      "urgent": "●"
    }
  },

    "battery": {
    "interval": 60,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "events": {
      "on-discharging-warning": "notify-send -u normal 'Low Battery'",
      "on-discharging-critical": "notify-send -u critical 'Very Low Battery'"
    },
    "format": "{icon} {capacity}%",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "max-length": 25
  },

  "mpris": {
    "format": " {title} - {artist} ",
    "format-paused": "󰐊 {title} - {artist} ",
    "max-length": 30,
    "tooltip": true,
    "player": "spotify"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 6
  },

  "wireplumber": {
    "scroll-step": 5,
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "on-click": "pavucontrol",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"],
      "headphones": "󰋋",
      "headset": "󰋎"
    }
  },
  "clock": {
    "format": "{:%a %d %b %H:%M:%S}",
    "format-alt": "{:%H:%M:%S}",
    "interval": 1,
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "first-day-of-week": 1,
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
      }
    }
  },

  "custom/lock": {
    "format": " ",
    "on-click": "~/.local/share/quickshell-lockscreen/lock.sh",
    "tooltip": true,
    "tooltip-format": "Lock Screen"
  },

  "custom/notification": {
    "format": "",
    "on-click": "swaync-client -t",
    "tooltip": true,
    "tooltip-format": "Notifications"
  },
    "custom/bluetooth": {
    "format": "󰂯",
    "tooltip": true,
    "tooltip-format": "Open Bluetooth settings",
    "on-click": "blueman-manager"
  },

  "custom/wifi": {
    "format": "󰖩",
    "tooltip": true,
    "tooltip-format": "Open Wi-Fi settings",
    "on-click": "nm-connection-editor"
  },
  "memory": {
    "format": "󰍛 {used:0.1f}G",
    "tooltip": true,
    "tooltip-format": "RAM: Used {used:0.1f}G / Total {total:0.1f}G",
    "interval": 4
  },

  "custom/cpu": {
    "exec": "sh -c \"usage=\\$(top -bn1 | awk '/Cpu\\\\(s\\\\)/ {for (i = 1; i <= NF; i++) if (\\$i == \\\"id,\\\") {printf \\\"%d\\\", 100 - \\$(i - 1); exit}}'); temp=\\$(sensors | awk '/Package id 0:/ {sub(/^[+]/, \\\"\\\", \\$4); print \\$4; exit}'); printf '󰻠 %s%% %s' \\\"\\$usage\\\" \\\"\\$temp\\\"\"",
    "interval": 4,
    "format": "{}",
    "tooltip": true,
    "tooltip-format": "CPU usage and temperature: {}"
  }

}
